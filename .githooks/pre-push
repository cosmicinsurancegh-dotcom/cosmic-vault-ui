#!/usr/bin/env bash
#
# Vercel deploys this app through its Git integration, and it only builds a
# commit when the commit *author* is the owner of the Vercel project. On the
# Hobby plan there is exactly one member, so a commit authored by anyone else
# is blocked before the build starts:
#
#   "Git author <login> must have access to the project on Vercel to create
#    deployments."
#
# The push itself succeeds, which is what makes this easy to miss - the failure
# only shows up in the Vercel dashboard and on the commit status. So this hook
# refuses the push instead: it reads the author of every commit a push would
# send and exits non-zero when any of them is an address other than the project
# owner's. A commit under another identity cannot reach `dev` or `main`, or a
# work branch that would carry it there, without saying so out loud.
#
# It tests one field - the author email - and nothing else, so it says nothing
# about the change itself. `git push --no-verify` is the way through when a
# commit by someone else genuinely does have to be pushed; the first push of an
# existing history to a new remote is the case that needs it, because every
# commit in it is new there.
#
# The second thing it watches is the `dev`/`main` ruleset documented in the
# README ("Merging into dev and main"), live since 2026-10-26 as `dev-main-gate`.
# GitHub refuses a push that moves one of those branches unless the pushed
# commits' `Vitest unit suite` checks already passed on another ref, and answers
# with
#
#   remote: error: GH013: Repository rule violations found for refs/heads/dev
#
# A push like that is refused outright rather than landing and failing later, so
# the hook says which ref a push is about to update and leaves the choice - pull
# request, or `--no-verify` - to the person pushing. This notice stays a warning,
# unlike the author check above, because the outcome is not locally knowable: the
# check rule on its own accepts a push whose commits already passed the check on
# another ref, and it is the `pull_request` rule alongside it that requires the
# branch to move through a merge.
#
# Installed by `bun install` (the `prepare` script sets
# `core.hooksPath=.githooks`); run that by hand if the hook does not fire:
#
#   git config core.hooksPath .githooks
#
# The expected author defaults to the project owner's GitHub noreply address.
# That list is what the check tests against, so adding an address to it is the
# other way to let one through; it takes repeated or comma/space separated
# values:
#
#   git config --local --add vercel.projectOwnerEmail "someone@example.com"
#
set -u

OWNER_DEFAULT="347948316+cosmicinsurancegh-dotcom@users.noreply.github.com"
ZERO="0000000000000000000000000000000000000000"
# Branches the ruleset protects. Compared against the *remote* ref, because that
# is the ref GitHub decides on. Keep in step with the ruleset's conditions in
# README.md if the protected branches ever change.
GATED_REFS="refs/heads/dev refs/heads/main"

is_gated() {
  case " $GATED_REFS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Configured owners, one per line, normalised on the way in so that
# "a@b.com, c@d.com" and repeated --add both work.
configured="$(git config --get-all vercel.projectOwnerEmail 2>/dev/null || true)"
if [ -n "$configured" ]; then
  owners="$(printf '%s\n' "$configured" | tr ', ' '\n\n' | sed '/^[[:space:]]*$/d')"
else
  owners="$OWNER_DEFAULT"
fi

is_owner() {
  printf '%s\n' "$owners" \
    | tr '[:upper:]' '[:lower:]' \
    | grep -Fxq "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
}

# <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
problems=""
count=0
gated=""
gated_count=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # Deleting a remote branch sends no commits.
  [ "$local_sha" = "$ZERO" ] && continue

  if is_gated "${remote_ref:-}"; then
    branch="${remote_ref#refs/heads/}"
    gated="${gated}   ${branch}  $(git log -1 --format='%h %s' "$local_sha" 2>/dev/null || printf '%s' "$local_sha")
"
    gated_count=$((gated_count + 1))
  fi

  if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
    # New branch: everything reachable here and not from any remote yet.
    commits="$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)"
  else
    commits="$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)"
  fi

  for sha in $commits; do
    author_email="$(git log -1 --format='%ae' "$sha" 2>/dev/null)"
    [ -n "$author_email" ] || continue
    is_owner "$author_email" && continue

    author_name="$(git log -1 --format='%an' "$sha")"
    subject="$(git log -1 --format='%s' "$sha")"
    problems="${problems}   $(printf '%s' "$sha" | cut -c1-7)  ${author_name} <${author_email}>
             ${subject}
"
    count=$((count + 1))
  done
done

if [ "$count" -gt 0 ]; then
  owner_hint="$(printf '%s\n' "$owners" | head -n 1)"
  {
    echo ""
    echo "! Refusing this push: ${count} commit(s) here are not authored by the"
    echo "  Vercel project owner, so Vercel would refuse to build them - the commit"
    echo "  would land on the branch with no deployment beside it:"
    echo ""
    printf '%s' "$problems"
    echo "  Expected author: ${owner_hint}"
    echo "  Commit as the owner:  git config --local user.email \"${owner_hint}\""
    echo "  Allow this author:    git config --local --add vercel.projectOwnerEmail \"<email>\""
    echo "  Push anyway:          git push --no-verify"
    echo ""
  } >&2
fi

if [ "$gated_count" -gt 0 ]; then
  {
    echo ""
    echo "! This push updates a branch protected by the dev/main ruleset:"
    echo ""
    printf '%s' "$gated"
    echo "  GitHub refuses a direct push to the branch unless the pushed commits'"
    echo "  Vitest unit suite checks already passed on another ref (the ruleset is"
    echo "  dev-main-gate; see README.md, \"Merging into dev and main\"). Expect:"
    echo ""
    echo "    remote: error: GH013: Repository rule violations found"
    echo ""
    echo "  Push a work branch and open a pull request into it instead."
    echo "  Skip this warning:  git push --no-verify"
    echo ""
  } >&2
fi

# The author check above is the block: it is the one failure that would otherwise
# land and quietly never deploy. The gated-ref notice is not - a push whose commits
# already passed the check on another ref is legitimate.
if [ "$count" -gt 0 ]; then
  exit 1
fi

exit 0
