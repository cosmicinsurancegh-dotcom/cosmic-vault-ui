.env.local
node_modules
dist

# Bun is the only package manager; bun.lock is the only lockfile. These are
# ignored so a stray npm/yarn/pnpm install cannot commit a second graph.
package-lock.json
yarn.lock
pnpm-lock.yaml
.vercel
test-results
playwright-report
blob-report
# Browser session dumps from the Playwright MCP tool, not project fixtures.
.playwright-mcp/

# Convex deploy keys for CI (never commit)
.env.convex-prod
.env.convex-dev
