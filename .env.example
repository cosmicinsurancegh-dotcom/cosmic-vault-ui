# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Supabase (Postgres, Storage, Realtime) ---------------------------------------
# Browser values: safe to ship, protected by row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with VITE_ - a VITE_ variable is
# inlined into the JavaScript bundle and handed to every visitor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Which backend serves each domain. Unset means `convex`, so a missing or
# misspelled value can only leave a domain where it already is. A domain is
# also held on Convex when the keys above are absent, whatever the flag says.
# Flip one domain at a time, e.g. VITE_DATA_PLANE_QUOTES=supabase.
VITE_DATA_PLANE=convex

# PostHog analytics and Session Replay (project token from PostHog project
# settings). Both are public browser values. Leave VITE_POSTHOG_KEY empty and
# nothing is sent at all; recording also stays off until a visitor allows
# analytics in the cookie banner.
VITE_POSTHOG_KEY=
# EU cloud by default; use https://us.i.posthog.com for a US project.
VITE_POSTHOG_HOST=
