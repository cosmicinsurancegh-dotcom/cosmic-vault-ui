# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# PostHog analytics and Session Replay (project token from PostHog project
# settings). Both are public browser values. Leave VITE_POSTHOG_KEY empty and
# nothing is sent at all; recording also stays off until a visitor allows
# analytics in the cookie banner.
VITE_POSTHOG_KEY=
# EU cloud by default; use https://us.i.posthog.com for a US project.
VITE_POSTHOG_HOST=
